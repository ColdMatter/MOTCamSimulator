Cell["\<\
Asymptotic diagnostics at nominal conditions: which term sets the noise \
floor, the molecule number at which signal shot noise overtakes the floor, \
the molecule number at which the peak superpixel saturates (20 ms), and the \
local log-log slope at three molecule numbers.\
\>", "Text",ExpressionUUID->"a9388206-645d-4e27-94f8-83a21eabf16c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"regimeDataset", " ", "=", " ", 
  RowBox[{"Dataset", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"cam", " ", "=", " ", 
            RowBox[{"cameraDatabase", "[", "name", "]"}]}], ",", " ", 
           "breakdown"}], "}"}], ",", "\n", "      ", 
         RowBox[{
          RowBox[{"breakdown", " ", "=", " ", 
           RowBox[{"noiseFloorBreakdown", "[", 
            RowBox[{
            "cam", ",", " ", "binFactor", ",", " ", "exposureTimeNominal", ",",
              " ", "backgroundMultiplierDefault", ",", " ", 
             RowBox[{"cam", "[", "\"\<ReadNoiseRMS\>\"", "]"}]}], "]"}]}], ";",
           "\n", "      ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Camera\>\"", " ", "->", " ", 
             RowBox[{"cameraShortName", "[", "name", "]"}]}], ",", " ", 
            RowBox[{"\"\<Bin\>\"", " ", "->", " ", 
             RowBox[{"binLabel", "[", "binFactor", "]"}]}], ",", "\n", 
            "        ", 
            RowBox[{"\"\<nSuper\>\"", " ", "->", " ", 
             RowBox[{"breakdown", "[", "\"\<Superpixels\>\"", "]"}]}], ",", 
            "\n", "        ", 
            RowBox[{"\"\<Read var (e-^2)\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"breakdown", "[", "\"\<ReadVariance\>\"", "]"}], ",", 
               " ", "3"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Scatter var (e-^2)\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"breakdown", "[", "\"\<ScatterVariance\>\"", "]"}], ",",
                " ", "3"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Dark var (e-^2)\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"breakdown", "[", "\"\<DarkVariance\>\"", "]"}], ",", 
               " ", "3"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Dominant floor\>\"", " ", "->", " ", 
             RowBox[{"breakdown", "[", "\"\<DominantFloorTerm\>\"", "]"}]}], ",",
             "\n", "        ", 
            RowBox[{"\"\<Shot-noise crossover nMol\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"moleculesFromSignalPhotons", "[", 
                RowBox[{
                 RowBox[{
                 "breakdown", "[", "\"\<ShotNoiseCrossoverPhotons\>\"", "]"}],
                  ",", " ", "exposureTimeNominal"}], "]"}], ",", " ", "3"}], 
              "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Saturation nMol\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"saturationMolecules", "[", 
                RowBox[{"cam", ",", " ", "binFactor"}], "]"}], ",", " ", 
               "3"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Slope @10 mol\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"localLogSlope", "[", 
                RowBox[{"cam", ",", " ", "binFactor", ",", " ", 
                 RowBox[{"signalPhotonsFromMolecules", "[", 
                  RowBox[{"10.", ",", " ", "exposureTimeNominal"}], "]"}]}], 
                "]"}], ",", " ", "3"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Slope @1e3 mol\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"localLogSlope", "[", 
                RowBox[{"cam", ",", " ", "binFactor", ",", " ", 
                 RowBox[{"signalPhotonsFromMolecules", "[", 
                  RowBox[{
                   RowBox[{"10.", "^", "3"}], ",", " ", 
                   "exposureTimeNominal"}], "]"}]}], "]"}], ",", " ", "3"}], 
              "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Slope @1e5 mol\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"localLogSlope", "[", 
                RowBox[{"cam", ",", " ", "binFactor", ",", " ", 
                 RowBox[{"signalPhotonsFromMolecules", "[", 
                  RowBox[{
                   RowBox[{"10.", "^", "5"}], ",", " ", 
                   "exposureTimeNominal"}], "]"}]}], "]"}], ",", " ", "3"}], 
              "]"}]}]}], "|>"}]}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", "cameraNames"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"binFactor", ",", " ", "benchmarkBins"}], "}"}]}], "]"}], ",",
      " ", "1"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"7519c745-671c-4213-9f17-e5498f3ebb8c"],

