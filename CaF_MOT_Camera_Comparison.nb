         RowBox[{"First", "[", 
          RowBox[{"Keys", "[", "modes", "]"}], "]"}]}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"readNoiseRMS", " ", "=", " ", 
       RowBox[{"modes", "[", "mode", "]"}]}], ";", "\n", "    ", 
      RowBox[{"SeedRandom", "[", 
       RowBox[{"Round", "[", "seed", "]"}], "]"}], ";", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xs", ",", " ", "ys"}], "}"}], " ", "=", " ", 
       RowBox[{"frameCoordinates", "[", 
        RowBox[{"cam", ",", " ", "binFactor"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"meanFrame", " ", "=", " ", 
       RowBox[{
        RowBox[{"signalMeanFrame", "[", 
         RowBox[{"cam", ",", " ", "binFactor", ",", " ", "nSig"}], "]"}], " ",
         "+", " ", 
        RowBox[{"backgroundElectrons", "[", 
         RowBox[{
         "cam", ",", " ", "binFactor", ",", " ", "tExp", ",", " ", 
          "multiplier"}], "]"}], " ", "+", " ", 
        RowBox[{"darkElectrons", "[", 
         RowBox[{"cam", ",", " ", "binFactor", ",", " ", "tExp"}], "]"}]}]}], 
      ";", "\n", "    ", 
      RowBox[{"frame", " ", "=", " ", 
       RowBox[{"syntheticFrame", "[", 
        RowBox[{
        "cam", ",", " ", "binFactor", ",", " ", "nSig", ",", " ", "tExp", ",",
          " ", "multiplier", ",", " ", "readNoiseRMS"}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"rowIndex", " ", "=", " ", 
       RowBox[{"First", "[", 
        RowBox[{"Ordering", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "ys", "]"}], ",", " ", "1"}], "]"}], "]"}]}], ";",
       "\n", "    ", 
      RowBox[{"fit", " ", "=", " ", 
       RowBox[{"fitCrossSection", "[", 
        RowBox[{"xs", ",", " ", 
         RowBox[{"frame", "[", 
          RowBox[{"[", "rowIndex", "]"}], "]"}]}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"image", " ", "=", " ", 
       RowBox[{"frameImage", "[", 
        RowBox[{"frame", ",", " ", "xs", ",", " ", "ys", ",", " ", 
         RowBox[{
          RowBox[{"cameraShortName", "[", "name", "]"}], " ", "<>", 
          " ", "\"\<, \>\"", " ", "<>", " ", 
          RowBox[{"binLabel", "[", "binFactor", "]"}], " ", "<>", 
          " ", "\"\<, \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"1000", " ", "tExp"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"5", ",", " ", "1"}], "}"}]}], "]"}], "]"}], " ", "<>", 
          " ", "\"\< ms, \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"roundSignificant", "[", 
            RowBox[{"nMol", ",", " ", "3"}], "]"}], "]"}], " ", "<>", 
          " ", "\"\< molecules\>\""}]}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"cut", " ", "=", " ", 
       RowBox[{"crossSectionPlot", "[", 
        RowBox[{
        "frame", ",", " ", "meanFrame", ",", " ", "xs", ",", " ", "ys", ",", 
         " ", "fit"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"card", " ", "=", " ", 
       RowBox[{"metricsCard", "[", 
        RowBox[{
        "cam", ",", " ", "name", ",", " ", "mode", ",", " ", "binFactor", ",",
          " ", "nMol", ",", " ", "rate", ",", " ", "tExp", ",", " ", 
         "multiplier", ",", " ", "readNoiseRMS", ",", " ", "frame", ",", " ", 
         "meanFrame", ",", " ", "xs", ",", " ", "ys", ",", " ", "fit"}], 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"Column", "[", 
       RowBox[{
