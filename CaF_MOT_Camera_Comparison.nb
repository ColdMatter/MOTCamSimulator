          " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "9"}]}]}]}], "]"}], ",", " ", "True", ",", " ", 
       RowBox[{
       "TestID", " ", "->", 
        " ", "\"\<BackgroundUsesSensorAreaNotObjectArea\>\""}]}], "]"}], ",", 
