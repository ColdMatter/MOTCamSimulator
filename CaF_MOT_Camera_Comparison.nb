       "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"nMolSat", " ", "=", " ", 
       RowBox[{"saturationMolecules", "[", 
        RowBox[{"cam", ",", " ", "binFactor"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
        "moleculeMin", " ", "<=", " ", "nMolSat", " ", "<=", " ", 
