 RowBox[{
  RowBox[{
   RowBox[{"fitCrossSection", "[", 
    RowBox[{"xs_List", ",", " ", "row_List"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "data", ",", " ", "amplitudeGuess", ",", " ", "offsetGuess", ",", " ", 
