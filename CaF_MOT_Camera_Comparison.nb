Cell[CellGroupData[{

Cell["\<\
1.5 How the SNR is defined: per pixel, top-hat aperture, or optimally weighted\
\>", "Subsection",ExpressionUUID->"39f5be9e-549a-4b6a-a0ff-179549077e39"],

Cell["\<\
\"The SNR\" is not a property of the camera alone: it depends on the \
estimator applied to the image. Three definitions are computed here, all for \
a signal frame minus an identical off-target reference frame.\
\>", "Text",ExpressionUUID->"e3619454-e629-4acf-bf77-9b388ea0806d"],

Cell["\<\
peakPixelSNR: signal to noise of the single brightest superpixel. This sets \
whether the cloud is visible by eye in a single shot, but it is NOT the \
precision of a molecule-number measurement.\
\>", "Text",ExpressionUUID->"04504964-8877-43e1-ab45-eff3731cc18c"],

Cell["\<\
topHatSNR: the flat sum over the 2 sigma aperture minus a reference aperture, \
i.e. the definition used in the benchmark sections. It is the natural \
estimator of the molecule number and is what most groups quote.\
\>", "Text",ExpressionUUID->"dfd007d3-97d7-4b8f-8142-2524d93af097"],

Cell["\<\
matchedFilterSNR: the same measurement made with the optimal \
(inverse-variance, profile-weighted) estimator, N proportional to Sum[wi di] \
with wi proportional to pi/sigmai^2. Its variance is the Cramer-Rao bound \
1/Sum[pi^2/sigmai^2], so no unbiased estimator of the molecule number can do \
better. In the shot-noise limit it coincides with the top-hat sum; when read \
noise or scatter dominates it wins, because pixels in the wings carry full \
noise but little signal and the flat sum weights them equally.\
\>", "Text",ExpressionUUID->"0b3e1402-9440-4ed9-aaf4-bdf2da2f759a"],

Cell["\<\
Also computed: widthPrecision, the fractional uncertainty on the cloud width \
from the Fisher information, delta sigma / sigma = 1/(sigma \
Sqrt[Sum[(dsi/dsigma)^2/sigmai^2]]). This is the figure of merit for \
time-of-flight thermometry and behaves differently from the number precision: \
it depends on resolving the profile, so it rewards small pixels and penalises \
coarse binning.\
\>", "Text",ExpressionUUID->"f64078f8-f5e3-427c-9877-521ad3d51191"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"estimatorFOV", " ", "=", " ", 
    RowBox[{"6", " ", "sigmaCloud"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"mm", " ", "at", " ", "the", " ", 
     RowBox[{"MOT", ":", " ", 
      RowBox[{
       RowBox[{"+", 
        RowBox[{"-", "3"}]}], " ", "sigma"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
     "which", " ", "holds", " ", "99", "%", " ", "of", " ", "a", " ", "2", 
      "D", " ", "Gaussian"}], ";", " ", 
     RowBox[{
     "the", " ", "truncated", " ", "wings", " ", "change", " ", "the", " ", 
      "estimators", " ", "by", " ", "well", " ", "under", " ", "1", "%"}]}]}],
    " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussianFractions1D", "[", 
    RowBox[{"centers_List", ",", " ", "pitchMm_", ",", " ", "sigmaMm_"}], 
    "]"}], " ", ":=", "\n", "  ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Erf", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"centers", " ", "+", " ", 
          RowBox[{"pitchMm", "/", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", "2.", "]"}], " ", "sigmaMm"}], ")"}]}], "]"}], 
      " ", "-", " ", 
      RowBox[{"Erf", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"centers", " ", "-", " ", 
          RowBox[{"pitchMm", "/", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", "2.", "]"}], " ", "sigmaMm"}], ")"}]}], 
       "]"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"estimatorCoordinates", "[", 
    RowBox[{"cam_Association", ",", " ", "binFactor_"}], "]"}], " ", ":=", 
   "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pitchMm", ",", " ", "count"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"pitchMm", " ", "=", " ", 
       RowBox[{
        RowBox[{"superpixelPitch", "[", 
         RowBox[{"cam", ",", " ", "binFactor"}], "]"}], "/", "1000."}]}], ";",
       "\n", "    ", 
      RowBox[{"count", " ", "=", " ", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"Round", "[", 
          RowBox[{"estimatorFOV", "/", "pitchMm"}], "]"}], ",", " ", "9"}], 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Range", "[", "count", "]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"count", " ", "+", " ", "1"}], ")"}], "/", "2."}]}], 
          ")"}], " ", "pitchMm"}], ",", " ", "pitchMm"}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"signalFractionGrid", "[", 
    RowBox[{"cam_Association", ",", " ", "binFactor_", ",", " ", "sigmaMm_"}],
     "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"coords", ",", " ", "pitchMm", ",", " ", "fractions"}], "}"}], ",",
      "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"coords", ",", " ", "pitchMm"}], "}"}], " ", "=", " ", 
       RowBox[{"estimatorCoordinates", "[", 
        RowBox[{"cam", ",", " ", "binFactor"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"fractions", " ", "=", " ", 
       RowBox[{"gaussianFractions1D", "[", 
        RowBox[{"coords", ",", " ", "pitchMm", ",", " ", "sigmaMm"}], "]"}]}],
       ";", "\n", "    ", 
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", " ", "fractions", ",", " ", "fractions"}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"snrEstimators", "[", 
    RowBox[{
    "cam_Association", ",", " ", "binFactor_", ",", " ", "nMol_", ",", " ", 
     "tExp_", ",", " ", "multiplier_", ",", " ", "readNoiseRMS_", ",", " ", 
     "rate_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "coords", ",", " ", "pitchMm", ",", " ", "fractionGrid", ",", " ", 
       "totalElectrons", ",", " ", "signalGrid", ",", " ", "varianceGrid", ",",
        " ", "floorPerPixel", ",", " ", "apertureMask", ",", "\n", 
       "          ", "peakSignal", ",", " ", "peakVariance", ",", " ", 
       "topHat", ",", " ", "matched", ",", " ", "fisherWidth", ",", " ", 
       "derivativeGrid", ",", " ", "delta", ",", " ", "nSig"}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{
      RowBox[{"nSig", " ", "=", " ", 
       RowBox[{"signalPhotonsFromMolecules", "[", 
        RowBox[{"nMol", ",", " ", "tExp", ",", " ", "rate"}], "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{"totalElectrons", " ", "=", " ", 
       RowBox[{"nSig", " ", 
        RowBox[{
         RowBox[{"cam", "[", "\"\<QE\>\"", "]"}], "/", 
         "apertureSignalFraction"}]}]}], ";", "   ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "electrons", " ", "from", " ", "the", " ", "whole", " ", "cloud"}], ",",
         " ", 
        RowBox[{"not", " ", "only", " ", "the", " ", "aperture"}]}], " ", 
       "*)"}], "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"coords", ",", " ", "pitchMm"}], "}"}], " ", "=", " ", 
       RowBox[{"estimatorCoordinates", "[", 
        RowBox[{"cam", ",", " ", "binFactor"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"fractionGrid", " ", "=", " ", 
       RowBox[{"signalFractionGrid", "[", 
        RowBox[{"cam", ",", " ", "binFactor", ",", " ", "sigmaCloud"}], 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"signalGrid", " ", "=", " ", 
       RowBox[{"totalElectrons", " ", "fractionGrid"}]}], ";", "\n", "    ", 
      RowBox[{"floorPerPixel", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"cam", "[", "\"\<ENF\>\"", "]"}], "^", "2"}], " ", "2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"backgroundElectrons", "[", 
            RowBox[{
            "cam", ",", " ", "binFactor", ",", " ", "tExp", ",", " ", 
             "multiplier"}], "]"}], " ", "+", " ", 
           RowBox[{"darkElectrons", "[", 
            RowBox[{"cam", ",", " ", "binFactor", ",", " ", "tExp"}], "]"}]}],
           ")"}]}], " ", "+", " ", 
        RowBox[{"2", " ", 
         RowBox[{
          RowBox[{"effectiveReadNoise", "[", 
           RowBox[{"cam", ",", " ", "binFactor", ",", " ", "readNoiseRMS"}], 
           "]"}], "^", "2"}]}]}]}], ";", "\n", "    ", 
      RowBox[{"varianceGrid", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"cam", "[", "\"\<ENF\>\"", "]"}], "^", "2"}], " ", 
         "signalGrid"}], " ", "+", " ", "floorPerPixel"}]}], ";", "\n", 
      "    ", 
      RowBox[{"apertureMask", " ", "=", " ", 
       RowBox[{"UnitStep", "[", 
        RowBox[{"apertureRadius", " ", "-", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Outer", "[", 
           RowBox[{"Plus", ",", " ", 
            RowBox[{"coords", "^", "2"}], ",", " ", 
            RowBox[{"coords", "^", "2"}]}], "]"}], "]"}]}], "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{"topHat", " ", "=", " ", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"signalGrid", " ", "apertureMask"}], ",", " ", "2"}], "]"}],
         "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"varianceGrid", " ", "apertureMask"}], ",", " ", "2"}], 
          "]"}], "]"}]}]}], ";", "\n", "    ", 
      RowBox[{"matched", " ", "=", " ", 
       RowBox[{"totalElectrons", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fractionGrid", "^", "2"}], "/", "varianceGrid"}], ",", 
           " ", "2"}], "]"}], "]"}]}]}], ";", "\n", "    ", 
      RowBox[{"peakSignal", " ", "=", " ", 
       RowBox[{"Max", "[", "signalGrid", "]"}]}], ";", "\n", "    ", 
      RowBox[{"peakVariance", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"cam", "[", "\"\<ENF\>\"", "]"}], "^", "2"}], " ", 
         "peakSignal"}], " ", "+", " ", "floorPerPixel"}]}], ";", "\n", 
      "    ", 
      RowBox[{"delta", " ", "=", " ", 
       RowBox[{"0.01", " ", "sigmaCloud"}]}], ";", "\n", "    ", 
      RowBox[{"derivativeGrid", " ", "=", " ", 
       RowBox[{"totalElectrons", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"signalFractionGrid", "[", 
            RowBox[{"cam", ",", " ", "binFactor", ",", " ", 
             RowBox[{"sigmaCloud", " ", "+", " ", "delta"}]}], "]"}], " ", "-",
            " ", 
           RowBox[{"signalFractionGrid", "[", 
            RowBox[{"cam", ",", " ", "binFactor", ",", " ", 
             RowBox[{"sigmaCloud", " ", "-", " ", "delta"}]}], "]"}]}], ")"}],
          "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "delta"}], ")"}]}]}]}], ";", "\n", "    ", 
      RowBox[{"fisherWidth", " ", "=", " ", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"derivativeGrid", "^", "2"}], "/", "varianceGrid"}], ",", 
         " ", "2"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<PeakPixelElectrons\>\"", " ", "->", " ", "peakSignal"}], 
        ",", " ", 
        RowBox[{"\"\<PeakPixelSNR\>\"", " ", "->", " ", 
         RowBox[{"peakSignal", "/", 
          RowBox[{"Sqrt", "[", "peakVariance", "]"}]}]}], ",", "\n", "      ", 
        RowBox[{"\"\<TopHatSNR\>\"", " ", "->", " ", "topHat"}], ",", " ", 
        RowBox[{"\"\<MatchedFilterSNR\>\"", " ", "->", " ", "matched"}], ",", 
        " ", 
        RowBox[{"\"\<MatchedGain\>\"", " ", "->", " ", 
         RowBox[{"matched", "/", "topHat"}]}], ",", "\n", "      ", 
        RowBox[{"\"\<NumberPrecision\>\"", " ", "->", " ", 
         RowBox[{"1", "/", "matched"}]}], ",", " ", 
        RowBox[{"\"\<WidthPrecision\>\"", " ", "->", " ", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"sigmaCloud", " ", 
            RowBox[{"Sqrt", "[", "fisherWidth", "]"}]}], ")"}]}]}], ",", "\n",
         "      ", 
        RowBox[{"\"\<PixelsInAperture\>\"", " ", "->", " ", 
         RowBox[{"Total", "[", 
          RowBox[{"apertureMask", ",", " ", "2"}], "]"}]}]}], "|>"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"snrEstimators", "[", 
    RowBox[{"cam_Association", ",", " ", "binFactor_", ",", " ", "nMol_"}], 
    "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"snrEstimators", "[", 
    RowBox[{
    "cam", ",", " ", "binFactor", ",", " ", "nMol", ",", " ", 
     "exposureTimeNominal", ",", " ", "backgroundMultiplierDefault", ",", " ", 
     RowBox[{"cam", "[", "\"\<ReadNoiseRMS\>\"", "]"}], ",", " ", 
     "scatteringRate"}], "]"}]}], ";"}]}], "Input",
