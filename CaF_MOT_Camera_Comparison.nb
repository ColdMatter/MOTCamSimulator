        RowBox[{"\"\<QE\>\"", " ", "->", " ", "0.68"}], ",", " ", 
        RowBox[{"\"\<ReadNoiseRMS\>\"", " ", "->", " ", "1.4"}], ",", "\n", 
        "     ", 
        RowBox[{"\"\<ReadNoiseModes\>\"", " ", "->", " ", 
