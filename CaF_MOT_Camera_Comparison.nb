Cell[CellGroupData[{

Cell["\<\
3. Choosing the SNR Definition: Per Pixel vs Top-Hat vs Optimal Weighting\
\>", "Section",ExpressionUUID->"4f59c8cf-880e-488c-aaf6-784adbd681ee"],

Cell["\<\
At the working point (10^4 molecules, 20 ms, 4x scatter) the three \
definitions differ by orders of magnitude, so quoting \"the SNR\" without \
saying which one is meaningless. The table gives all three, the gain from \
optimal weighting, and the resulting fractional precision on the molecule \
number and on the cloud width.\
\>", "Text",ExpressionUUID->"c6c4ec33-d8c1-4e9a-ab5b-54b26f3ecb3b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"workingPointMolecules", " ", "=", " ", 
   RowBox[{"10", "^", "4"}]}], ";"}], "\n", 
 RowBox[{"estimatorDataset", " ", "=", " ", 
  RowBox[{"Dataset", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"cam", " ", "=", " ", 
            RowBox[{"cameraDatabase", "[", "name", "]"}]}], ",", " ", "est"}],
           "}"}], ",", "\n", "      ", 
         RowBox[{
          RowBox[{"est", " ", "=", " ", 
           RowBox[{"snrEstimators", "[", 
            RowBox[{
            "cam", ",", " ", "binFactor", ",", " ", "workingPointMolecules"}],
             "]"}]}], ";", "\n", "      ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Camera\>\"", " ", "->", " ", 
             RowBox[{"cameraShortName", "[", "name", "]"}]}], ",", " ", 
            RowBox[{"\"\<Bin\>\"", " ", "->", " ", 
             RowBox[{"binLabel", "[", "binFactor", "]"}]}], ",", "\n", 
            "        ", 
            RowBox[{"\"\<Object pitch (um)\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"superpixelPitch", "[", 
                RowBox[{"cam", ",", " ", "binFactor"}], "]"}], ",", " ", 
               "3"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Peak e-/pixel\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"est", "[", "\"\<PeakPixelElectrons\>\"", "]"}], ",", 
               " ", "3"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Peak-pixel SNR\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"est", "[", "\"\<PeakPixelSNR\>\"", "]"}], ",", " ", 
               "3"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Top-hat SNR\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"est", "[", "\"\<TopHatSNR\>\"", "]"}], ",", " ", 
               "4"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Matched-filter SNR\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"est", "[", "\"\<MatchedFilterSNR\>\"", "]"}], ",", 
               " ", "4"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Optimal gain\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"est", "[", "\"\<MatchedGain\>\"", "]"}], ",", " ", 
               "3"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<dN/N (%)\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"100", " ", 
                RowBox[{"est", "[", "\"\<NumberPrecision\>\"", "]"}]}], ",", 
               " ", "3"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<dWidth/Width (%)\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"100", " ", 
                RowBox[{"est", "[", "\"\<WidthPrecision\>\"", "]"}]}], ",", 
               " ", "3"}], "]"}]}]}], "|>"}]}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", "cameraNames"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"binFactor", ",", " ", "benchmarkBins"}], "}"}]}], "]"}], ",",
      " ", "1"}], "]"}], "]"}]}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"59634cba-096e-4726-8eab-bd14f9d435ea"],

