            RowBox[{"cam", ",", " ", "binFactor", ",", " ", "tExp"}], "]"}]}],
           ")"}]}], " ", "+", " ", 
        RowBox[{"2", " ", 
         RowBox[{
          RowBox[{"effectiveReadNoise", "[", 
           RowBox[{"cam", ",", " ", "binFactor", ",", " ", "readNoiseRMS"}], 
           "]"}], "^", "2"}]}]}]}], ";", "\n", "    ", 
      RowBox[{"peakElectrons", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"targetSNR", "^", "2"}], " ", "enfSquared"}], " ", "+", 
          " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"targetSNR", "^", "4"}], " ", 
             RowBox[{"enfSquared", "^", "2"}]}], " ", "+", " ", 
            RowBox[{"4", " ", 
             RowBox[{"targetSNR", "^", "2"}], " ", "floorVariance"}]}], 
           "]"}]}], ")"}], "/", "2"}]}], ";", "\n", "    ", 
      RowBox[{"electronsPerMolecule", " ", "=", " ", 
       RowBox[{"peakSuperpixelElectrons", "[", 
        RowBox[{"cam", ",", " ", "binFactor", ",", " ", 
         RowBox[{"photonsPerMolecule", "[", 
          RowBox[{"tExp", ",", " ", "rate"}], "]"}]}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"peakElectrons", "/", "electronsPerMolecule"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"visibilityMolecules", "[", 
    RowBox[{
    "cam_Association", ",", " ", "binFactor_", ",", " ", "targetSNR_"}], 
