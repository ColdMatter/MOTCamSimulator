       RowBox[{
       "TestID", " ", "->", " ", "\"\<LimitingApertureIsImagingLens\>\""}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"VerificationTest", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"magnification", " ", "-", " ", 
           RowBox[{"28.6", "/", "59.8"}]}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Abs", "[", 
