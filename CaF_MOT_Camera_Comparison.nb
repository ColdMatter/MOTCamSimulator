\>", "Section",ExpressionUUID->"e34c3ab5-62eb-44e4-bd3d-ffb58463938b"],

Cell["\<\
Closed-form minimum number of molecules in the MOT (20 ms exposure, 4x \
baseline scatter, 1e6 photons/s per molecule) for every camera, quoted \
readout mode and benchmark binning, together with the equivalent signal \
photons in the aperture and the molecule number at which the peak superpixel \
saturates.\
\>", "Text",ExpressionUUID->"c11696a1-dc5b-4409-a5a3-517f2f97fce9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"thresholdTable", " ", "=", " ", 
  RowBox[{"Dataset", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"cam", " ", "=", " ", 
            RowBox[{"cameraDatabase", "[", "name", "]"}]}], ",", " ", 
           RowBox[{"readNoiseRMS", " ", "=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"cameraDatabase", "[", "name", "]"}], 
              "[", "\"\<ReadNoiseModes\>\"", "]"}], "[", "mode", "]"}]}], ",",
            " ", "minThree", ",", " ", "minTen"}], "}"}], ",", "\n", "      ", 
         RowBox[{
          RowBox[{"minThree", " ", "=", " ", 
           RowBox[{"minimumSignalPhotons", "[", 
            RowBox[{
            "cam", ",", " ", "binFactor", ",", " ", "3", ",", " ", 
             "exposureTimeNominal", ",", " ", "backgroundMultiplierDefault", ",",
              " ", "readNoiseRMS"}], "]"}]}], ";", "\n", "      ", 
          RowBox[{"minTen", " ", "=", " ", 
           RowBox[{"minimumSignalPhotons", "[", 
            RowBox[{
            "cam", ",", " ", "binFactor", ",", " ", "10", ",", " ", 
             "exposureTimeNominal", ",", " ", "backgroundMultiplierDefault", ",",
              " ", "readNoiseRMS"}], "]"}]}], ";", "\n", "      ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Camera\>\"", " ", "->", " ", 
             RowBox[{"cameraShortName", "[", "name", "]"}]}], ",", " ", 
            RowBox[{"\"\<Readout mode\>\"", " ", "->", " ", "mode"}], ",", 
            " ", 
            
            RowBox[{"\"\<Read noise (e-)\>\"", " ", "->", " ", 
             "readNoiseRMS"}], ",", "\n", "        ", 
            RowBox[{"\"\<Bin\>\"", " ", "->", " ", 
             RowBox[{"binLabel", "[", "binFactor", "]"}]}], ",", " ", 
            RowBox[{"\"\<nSuper\>\"", " ", "->", " ", 
             RowBox[{"superpixelCount", "[", 
              RowBox[{"cam", ",", " ", "binFactor"}], "]"}]}], ",", "\n", 
            "        ", 
            RowBox[{"\"\<Eff. read noise (e-)\>\"", " ", "->", " ", 
             RowBox[{"effectiveReadNoise", "[", 
              RowBox[{
              "cam", ",", " ", "binFactor", ",", " ", "readNoiseRMS"}], 
              "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Bg e-/superpixel\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"backgroundElectrons", "[", 
                RowBox[{
                "cam", ",", " ", "binFactor", ",", " ", "exposureTimeNominal",
                  ",", " ", "backgroundMultiplierDefault"}], "]"}], ",", " ", 
               "4"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<nMol (SNR=3)\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"moleculesFromSignalPhotons", "[", 
                RowBox[{"minThree", ",", " ", "exposureTimeNominal"}], "]"}], 
               ",", " ", "4"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<nMol (SNR=10)\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"moleculesFromSignalPhotons", "[", 
                RowBox[{"minTen", ",", " ", "exposureTimeNominal"}], "]"}], ",",
                " ", "4"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<nSig (SNR=3)\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{"minThree", ",", " ", "4"}], "]"}]}], ",", " ", 
            RowBox[{"\"\<nSig (SNR=10)\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{"minTen", ",", " ", "4"}], "]"}]}], ",", "\n", 
            "        ", 
            RowBox[{"\"\<Saturation nMol\>\"", " ", "->", " ", 
             RowBox[{"roundSignificant", "[", 
              RowBox[{
               RowBox[{"saturationMolecules", "[", 
                RowBox[{"cam", ",", " ", "binFactor"}], "]"}], ",", " ", 
               "3"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<Primary mode\>\"", " ", "->", " ", 
             RowBox[{"(", 
              RowBox[{"readNoiseRMS", " ", "==", " ", 
               RowBox[{"cam", "[", "\"\<ReadNoiseRMS\>\"", "]"}]}], ")"}]}]}],
            "|>"}]}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", "cameraNames"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"mode", ",", " ", 
         RowBox[{"Keys", "[", 
          RowBox[{
           RowBox[{"cameraDatabase", "[", "name", "]"}], 
           "[", "\"\<ReadNoiseModes\>\"", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"binFactor", ",", " ", "benchmarkBins"}], "}"}]}], "]"}], ",",
      " ", "2"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"a840e198-cb42-436f-a54a-81cbfd27e729"],

