        RowBox[{"\"\<DarkCurrent\>\"", " ", "->", " ", "0.26"}], ",", " ", 
        RowBox[{"\"\<FullWell\>\"", " ", "->", " ", "23000"}], ",", "\n", 
        "     ", 
        RowBox[{"\"\<BinningType\>\"", " ", "->", 
         " ", "\"\<On-chip 2\[Times]2 + software\>\""}], ",", " ", 
        RowBox[{"\"\<HardwareBinLimit\>\"", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"\"\<SupportedBins\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "4", ",", " ", "8"}], "}"}]}],
         ",", " ", 
        RowBox[{"\"\<ENF\>\"", " ", "->", " ", "1.0"}], ",", "\n", "     ", 
        RowBox[{"\"\<Notes\>\"", " ", "->", 
         " ", "\"\<Andor CB2 brochure: QE 68% at 606 nm read from the \
published curve (peak 74% at 550 nm); read noise 1.4 e- in 12-bit at 24 dB \
analogue gain; dark current 0.26 e-/p/s at +20 C; full well 23 ke- at lowest \
gain (14-bit HDR mode combines both). 2x2 charge-domain binning on chip gives \
9 um superpixels at the same 1.4 e-, which is why the 1.7F/0.5F models (9 um, \
2.6 e-) are not listed separately.\>\""}]}], "|>"}]}]}], "\n", "|>"}]}], 
