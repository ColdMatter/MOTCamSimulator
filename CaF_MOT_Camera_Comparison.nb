         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"backgroundElectrons", "[", 
             RowBox[{"cam", ",", " ", "1", ",", " ", "0.02", ",", " ", "4."}],
              "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"backgroundFluxDensity", "[", "4.", "]"}], " ", 
