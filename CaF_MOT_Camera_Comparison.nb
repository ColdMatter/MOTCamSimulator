                    RowBox[{"0.005`", ",", "0.01`"}], "}"}], "]"}], ",", 
                    RowBox[{"AbsoluteThickness", "[", "1.8`", "]"}]}], 
                    "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                 RowBox[{#, ",", #2, ",", #3}], "}"}], ",", 
               RowBox[{"LegendLabel", "\[Rule]", "\"Binning\""}]}], "]"}]& ), 
          Editable -> True]}, {
         TemplateBox[{"\"peak superpixel = full well\""}, "PointLegend", 
          DisplayFunction -> (FormBox[
            StyleBox[
             StyleBox[
              PaneBox[
               TagBox[
                GridBox[{{
                   StyleBox[
                   "\"Saturation (20 ms)\"", {FontFamily -> "Arial"}, 
                    Background -> Automatic, StripOnInput -> False]}, {
                   TagBox[
                    GridBox[{{
                    TagBox[
                    GridBox[{{
                    GraphicsBox[{{}, {
                    Directive[
                    PointSize[0.5], 
                    AbsoluteThickness[1.6], 
                    GrayLevel[0.5], 
                    EdgeForm[
                    Directive[
                    Opacity[0.3], 
                    GrayLevel[0]]]], {
                    InsetBox[
                    GraphicsBox[{
                    EdgeForm[
                    GrayLevel[0]], 
                    GrayLevel[0.5], 
                    DiskBox[{0, 0}]}, {DefaultBaseStyle -> {"Graphics", {
                    AbsolutePointSize[6]}, 
