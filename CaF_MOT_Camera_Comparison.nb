Cell[CellGroupData[{

Cell["8. Verification Tests", "Section",ExpressionUUID->"d21e1ec3-d50b-4a0a-8745-d7022b92e961"],

Cell["\<\
Automated assertions run by the generator script: collection geometry, \
read-noise binning rules, synthetic frame dimensions against the ROI \
calculation, consistency of the closed-form threshold with the SNR function, \
physical monotonicity, and absence of global-scope leakage from the dashboard \
code.\
\>", "Text",ExpressionUUID->"2e3a7686-c22a-4be0-a813-74f7ec72a54a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"verificationTests", " ", "=", " ", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"VerificationTest", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"geometricEfficiencyUnvignetted", " ", "-", " ", "0.0559"}], 
         "]"}], " ", "<", " ", "0.001"}], ",", " ", "True", ",", " ", 
       RowBox[{
       "TestID", " ", "->", " ", "\"\<GeometricEfficiencyUnvignetted\>\""}]}],
       "]"}], ",", "\n", "   ", 
     RowBox[{"VerificationTest", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"solidAngleCollection", "[", 
           RowBox[{"workingDistance", ",", " ", "collectorRadius"}], "]"}], 
          " ", "-", " ", "0.7025"}], "]"}], " ", "<", " ", "0.001"}], ",", 
       " ", "True", ",", " ", 
       RowBox[{"TestID", " ", "->", " ", "\"\<SolidAngleUnvignetted\>\""}]}], 
