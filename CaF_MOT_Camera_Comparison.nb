               RowBox[{"LegendMarkers", "\[Rule]", 
                 RowBox[{"{", 
                   GraphicsBox[{
                    EdgeForm[
                    GrayLevel[0]], 
                    GrayLevel[0.5], 
                    DiskBox[{0, 0}]}], "}"}]}], ",", 
               RowBox[{"LegendMarkerSize", "\[Rule]", "10"}], ",", 
               RowBox[{"LegendLabel", "\[Rule]", "\"Saturation (20 ms)\""}]}],
