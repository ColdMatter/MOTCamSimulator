Cell["\<\
The same curves split by camera, which makes the hardware-versus-software \
binning behaviour visible.\
\>", "Text",ExpressionUUID->"6074a39a-9d45-4d3e-9acc-ac19c3d37f6c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"benchmarkPanel", "[", "name_String", "]"}], " ", ":=", " ", 
   RowBox[{"LogLogPlot", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"integratedSNRMolecules", "[", 
         RowBox[{
          RowBox[{"cameraDatabase", "[", "name", "]"}], ",", " ", "#", ",", 
          " ", "nMol"}], "]"}], " ", "&"}], " ", "/@", " ", "benchmarkBins"}],
       "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"nMol", ",", " ", "moleculeMin", ",", " ", "moleculeMax"}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"cameraColors", "[", "name", "]"}], ",", " ", 
           RowBox[{"binDashing", "[", "#", "]"}], ",", " ", 
           RowBox[{"AbsoluteThickness", "[", "1.8", "]"}]}], "]"}], " ", 
         "&"}], " ", "/@", " ", "benchmarkBins"}], ")"}]}], ",", "\n", "   ", 
     
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"moleculeMin", ",", " ", "moleculeMax"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", " ", "3*^5"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", "\n", "   ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<nMol\>\"", ",", " ", "\"\<SNR\>\""}], "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cameraShortName", "[", "name", "]"}], " ", "<>", 
         " ", "\"\< (\>\"", " ", "<>", " ", 
         RowBox[{
          RowBox[{"cameraDatabase", "[", "name", "]"}], 
          "[", "\"\<BinningType\>\"", "]"}], " ", "<>", 
         " ", "\"\< binning)\>\""}], ",", " ", "11"}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"3", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Red", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"10", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"Darker", "[", "Red", "]"}], ",", " ", "Dashed"}], 
             "]"}]}], "}"}]}], "}"}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"saturationMarker", "[", 
          RowBox[{"name", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "benchmarkBins"}], ")"}]}], ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{"binLabel", " ", "/@", " ", "benchmarkBins"}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"0.25", ",", " ", "0.8"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"benchmarkGrid", " ", "=", " ", 
  RowBox[{"Multicolumn", "[", 
   RowBox[{
    RowBox[{"benchmarkPanel", " ", "/@", " ", "cameraNames"}], ",", " ", "3", 
    ",", " ", 
    RowBox[{"Appearance", " ", "->", " ", "\"\<Horizontal\>\""}]}], 
   "]"}]}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"d673fd30-b6e7-46d8-a7ab-6dc7722eee50"],

