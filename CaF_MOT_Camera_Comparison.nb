Cell[CellGroupData[{

Cell["5. Spatial Resolution vs Binning Factor", "Section",ExpressionUUID->"daa24f52-6254-4124-b23c-409dd709eaa3"],

Cell["\<\
With magnification M = 0.478 a superpixel of physical pitch b x pixelPitch \
samples b x pixelPitch / M at the MOT, so the demagnification coarsens the \
object-space sampling by a factor 2.1 relative to a 1:1 relay. The number of \
resolution elements across the MOT FWHM (2.8 mm) is FWHM / object-space \
superpixel pitch; at least ~5 elements are needed to fit a Gaussian width \
reliably.\
\>", "Text",ExpressionUUID->"c2a61c94-b3a3-457f-a94c-6035c1be1554"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"resolutionElementsAcrossFWHM", "[", 
    RowBox[{"cam_Association", ",", " ", "binFactor_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"1000", " ", 
    RowBox[{"cloudFWHM", "/", 
     RowBox[{"superpixelPitch", "[", 
      RowBox[{"cam", ",", " ", "binFactor"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{"resolutionDataset", " ", "=", " ", 
  RowBox[{"Dataset", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cam", " ", "=", " ", 
           RowBox[{"cameraDatabase", "[", "name", "]"}]}], "}"}], ",", "\n", 
         "      ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Camera\>\"", " ", "->", " ", 
            RowBox[{"cameraShortName", "[", "name", "]"}]}], ",", " ", 
           RowBox[{"\"\<Binning\>\"", " ", "->", " ", 
            RowBox[{"cam", "[", "\"\<BinningType\>\"", "]"}]}], ",", " ", 
           RowBox[{"\"\<Bin\>\"", " ", "->", " ", 
            RowBox[{"binLabel", "[", "binFactor", "]"}]}], ",", "\n", 
           "        ", 
           RowBox[{"\"\<Sensor pitch (um)\>\"", " ", "->", " ", 
            RowBox[{"sensorSuperpixelPitch", "[", 
             RowBox[{"cam", ",", " ", "binFactor"}], "]"}]}], ",", "\n", 
           "        ", 
           RowBox[{"\"\<Object pitch (um)\>\"", " ", "->", " ", 
            RowBox[{"roundSignificant", "[", 
             RowBox[{
              RowBox[{"superpixelPitch", "[", 
               RowBox[{"cam", ",", " ", "binFactor"}], "]"}], ",", " ", "3"}],
              "]"}]}], ",", "\n", "        ", 
           RowBox[{"\"\<Elements across FWHM\>\"", " ", "->", " ", 
            RowBox[{"roundSignificant", "[", 
             RowBox[{
              RowBox[{"resolutionElementsAcrossFWHM", "[", 
               RowBox[{"cam", ",", " ", "binFactor"}], "]"}], ",", " ", "4"}],
              "]"}]}], ",", "\n", "        ", 
           RowBox[{"\"\<Superpixels in aperture\>\"", " ", "->", " ", 
            RowBox[{"superpixelCount", "[", 
             RowBox[{"cam", ",", " ", "binFactor"}], "]"}]}]}], "|>"}]}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", "cameraNames"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"binFactor", ",", " ", 
         RowBox[{
          RowBox[{"cameraDatabase", "[", "name", "]"}], 
          "[", "\"\<SupportedBins\>\"", "]"}]}], "}"}]}], "]"}], ",", " ", 
     "1"}], "]"}], "]"}]}]}], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"55d27a3e-6d5e-400d-9233-abcff5cda341"],

