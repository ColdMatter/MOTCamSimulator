Cell[BoxData[{
 RowBox[{
  RowBox[{"moleculeMin", " ", "=", " ", 
   RowBox[{"First", "[", "moleculeNumberRange", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"moleculeMax", " ", "=", " ", 
   RowBox[{"Last", "[", "moleculeNumberRange", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"benchmarkBins", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "4"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"binDashing", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"1", " ", "->", " ", 
      RowBox[{"Dashing", "[", 
       RowBox[{"{", "}"}], "]"}]}], ",", " ", 
     RowBox[{"2", " ", "->", " ", 
      RowBox[{"Dashing", "[", 
       RowBox[{"{", 
        RowBox[{"0.025", ",", " ", "0.012"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"4", " ", "->", " ", 
      RowBox[{"Dashing", "[", 
       RowBox[{"{", 
        RowBox[{"0.005", ",", " ", "0.010"}], "}"}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"binLabel", "[", "binFactor_Integer", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"ToString", "[", "binFactor", "]"}], " ", "<>", 
    " ", "\"\<\[Times]\>\"", " ", "<>", " ", 
    RowBox[{"ToString", "[", "binFactor", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"benchmarkCurveKeys", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"name", ",", " ", "binFactor"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", "cameraNames"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"binFactor", ",", " ", "benchmarkBins"}], "}"}]}], "]"}], ",",
      " ", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"benchmarkCurveStyles", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"cameraColors", "[", "#1", "]"}], ",", " ", 
        RowBox[{"binDashing", "[", "#2", "]"}], ",", " ", 
