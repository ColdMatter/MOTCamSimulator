              RowBox[{"4.5", ",", " ", "4.5"}], "}"}], "]"}]}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"{", "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"saturationMarkers", " ", "=", " ", 
   RowBox[{"saturationMarker", " ", "@@@", " ", "benchmarkCurveKeys"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"asymptoteAnnotations", " ", "=", " ", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"Directive", "[", 
      RowBox[{"Gray", ",", " ", 
       RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", " ", 
       RowBox[{"Dashing", "[", 
        RowBox[{"{", 
         RowBox[{"0.01", ",", " ", "0.006"}], "}"}], "]"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Line", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", "12.", "]"}], ",", " ", 
          RowBox[{"Log", "[", "0.6", "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", "300.", "]"}], ",", " ", 
          RowBox[{"Log", "[", "15.", "]"}]}], "}"}]}], "}"}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Line", "[", 
      RowBox[{"{", 
