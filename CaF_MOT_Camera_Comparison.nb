 RowBox[{
  RowBox[{
   RowBox[{"dashboardView", "[", 
    RowBox[{
    "name_String", ",", " ", "modeRequested_", ",", " ", "binRequested_", ",",
      " ", "nMol_", ",", " ", "rate_", ",", " ", "tExp_", ",", " ", 
     "multiplier_", ",", " ", "seed_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "cam", ",", " ", "bins", ",", " ", "binFactor", ",", " ", "modes", ",", 
       " ", "mode", ",", " ", "readNoiseRMS", ",", " ", "nSig", ",", " ", 
       "frame", ",", " ", "meanFrame", ",", " ", "xs", ",", " ", "ys", ",", 
       " ", "fit", ",", " ", "rowIndex", ",", " ", "image", ",", " ", "cut", ",",
        " ", "card"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"cam", " ", "=", " ", 
       RowBox[{"cameraDatabase", "[", "name", "]"}]}], ";", "\n", "    ", 
      RowBox[{"nSig", " ", "=", " ", 
       RowBox[{"signalPhotonsFromMolecules", "[", 
        RowBox[{"nMol", ",", " ", "tExp", ",", " ", "rate"}], "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{"bins", " ", "=", " ", 
       RowBox[{"cam", "[", "\"\<SupportedBins\>\"", "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"binFactor", " ", "=", " ", 
