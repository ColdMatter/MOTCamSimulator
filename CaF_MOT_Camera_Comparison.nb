      "    ", 
     RowBox[{
      RowBox[{"data", " ", "=", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"xs", ",", " ", "row"}], "}"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"offsetGuess", " ", "=", " ", 
       RowBox[{"Median", "[", "row", "]"}]}], ";", "\n", "    ", 
      RowBox[{"amplitudeGuess", " ", "=", " ", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", "row", "]"}], " ", "-", " ", "offsetGuess"}], ",",
          " ", "1."}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"pitchMm", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "xs", "]"}], " ", ">", " ", "1"}], ",", " ", 
         
         RowBox[{
          RowBox[{"xs", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
          RowBox[{"xs", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", "sigmaCloud"}], 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"fit", " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"NonlinearModelFit", "[", 
           RowBox[{"data", ",", " ", 
            RowBox[{
             RowBox[{"fitAmplitude", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"fitVariable", " ", "-", " ", "fitCentre"}], ")"}],
                   "^", "2"}]}], "/", 
                RowBox[{"(", 
                 RowBox[{"2", " ", 
                  RowBox[{"fitWidth", "^", "2"}]}], ")"}]}], "]"}]}], " ", "+",
              " ", "fitOffset"}], ",", "\n", "        ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"fitAmplitude", ",", " ", "amplitudeGuess"}], "}"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"fitCentre", ",", " ", "0."}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"fitWidth", ",", " ", "sigmaCloud"}], "}"}], ",", " ", 
              
              RowBox[{"{", 
               RowBox[{"fitOffset", ",", " ", "offsetGuess"}], "}"}]}], "}"}],
