         "binRequested", ",", " ", 
         RowBox[{"First", "[", "bins", "]"}]}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"modes", " ", "=", " ", 
       RowBox[{"cam", "[", "\"\<ReadNoiseModes\>\"", "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"mode", " ", "=", " ", 
