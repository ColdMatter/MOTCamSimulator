Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"visibilityDataset", " ", "=", " ", 
  RowBox[{"Dataset", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cam", " ", "=", " ", 
           RowBox[{"cameraDatabase", "[", "name", "]"}]}], "}"}], ",", "\n", 
         "      ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Camera\>\"", " ", "->", " ", 
            RowBox[{"cameraShortName", "[", "name", "]"}]}], ",", " ", 
           RowBox[{"\"\<Binning\>\"", " ", "->", " ", 
            RowBox[{"cam", "[", "\"\<BinningType\>\"", "]"}]}], ",", " ", 
           RowBox[{"\"\<Bin\>\"", " ", "->", " ", 
            RowBox[{"binLabel", "[", "binFactor", "]"}]}], ",", "\n", 
           "        ", 
           RowBox[{"\"\<Object pitch (um)\>\"", " ", "->", " ", 
            RowBox[{"roundSignificant", "[", 
             RowBox[{
              RowBox[{"superpixelPitch", "[", 
               RowBox[{"cam", ",", " ", "binFactor"}], "]"}], ",", " ", "3"}],
              "]"}]}], ",", "\n", "        ", 
           RowBox[{"\"\<Elements across FWHM\>\"", " ", "->", " ", 
            RowBox[{"Round", "[", 
             RowBox[{"resolutionElementsAcrossFWHM", "[", 
              RowBox[{"cam", ",", " ", "binFactor"}], "]"}], "]"}]}], ",", 
           "\n", "        ", 
           RowBox[{"\"\<Peak SNR at 10^4 mol\>\"", " ", "->", " ", 
            RowBox[{"roundSignificant", "[", 
             RowBox[{
              RowBox[{"peakPixelSNR", "[", 
               RowBox[{
               "cam", ",", " ", "binFactor", ",", " ", 
                "workingPointMolecules"}], "]"}], ",", " ", "3"}], "]"}]}], ",",
            "\n", "        ", 
           RowBox[{"\"\<Molecules for peak SNR = 3\>\"", " ", "->", " ", 
            RowBox[{"roundSignificant", "[", 
             RowBox[{
              RowBox[{"visibilityMolecules", "[", 
               RowBox[{
               "cam", ",", " ", "binFactor", ",", " ", 
                "visibilityThresholdMarginal"}], "]"}], ",", " ", "3"}], 
             "]"}]}], ",", "\n", "        ", 
           RowBox[{"\"\<Molecules for peak SNR = 5\>\"", " ", "->", " ", 
            RowBox[{"roundSignificant", "[", 
             RowBox[{
              RowBox[{"visibilityMolecules", "[", 
               RowBox[{
               "cam", ",", " ", "binFactor", ",", " ", 
                "visibilityThreshold"}], "]"}], ",", " ", "3"}], "]"}]}], ",",
            "\n", "        ", 
           RowBox[{"\"\<Visible at 10^4?\>\"", " ", "->", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"peakPixelSNR", "[", 
                RowBox[{
                "cam", ",", " ", "binFactor", ",", " ", 
                 "workingPointMolecules"}], "]"}], " ", ">=", " ", 
               "visibilityThreshold"}], ",", " ", "\"\<yes\>\"", ",", 
              " ", "\"\<no\>\""}], "]"}]}]}], "|>"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", "cameraNames"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"binFactor", ",", " ", 
         RowBox[{
          RowBox[{"cameraDatabase", "[", "name", "]"}], 
          "[", "\"\<SupportedBins\>\"", "]"}]}], "}"}]}], "]"}], ",", " ", 
     "1"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"49c70ab9-483c-4d91-990b-27e387842fc1"],

