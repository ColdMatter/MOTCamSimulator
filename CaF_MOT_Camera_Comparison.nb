Cell[CellGroupData[{

Cell["6. Interactive MOT Dashboard", "Section",ExpressionUUID->"a1f15050-41e1-4e96-95b1-a93a0ecbd7b3"],

Cell["\<\
Controls: camera, readout mode, binning, number of molecules (10 to 10^6), \
scattering rate per molecule, exposure, background multiplier and noise seed. \
A synthetic frame is generated for the selected camera and binning over a 2.5 \
mm x 2.5 mm field of view: the expected electrons per superpixel are the \
exact Gaussian pixel integrals (via Erf) plus background and dark electrons; \
the shot noise is Poisson (excess-noise factor applied as a variance \
multiplier for the EMCCD), and Gaussian read noise with the effective \
(binned) rms is added. The centre row is fitted with a Gaussian plus offset \
and the metrics card compares the fit with the analytic model.\
\>", "Text",ExpressionUUID->"eafe5513-9d3c-4df5-a05a-abab6c83f401"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"syntheticFrameFOV", " ", "=", " ", 
    RowBox[{"2.6", " ", "cloudFWHM"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"mm", " ", "at", " ", "the", " ", 
     RowBox[{"MOT", ":", " ", 
      RowBox[{"1.5", " ", "aperture", " ", "diameters"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"leaving", " ", "room", " ", "for", " ", "the", " ", "off"}], "-", 
     RowBox[{"target", " ", "reference", " ", "annulus"}]}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"poissonSample", " ", "=", " ", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"mu", ",", " ", "_Real"}], "}"}], "}"}], ",", "\n", "   ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"limit", ",", " ", "k", ",", " ", "p"}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"mu", " ", "<=", " ", "0."}], ",", " ", "0.", ",", "\n", 
         "       ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"mu", " ", ">", " ", "50."}], ",", "\n", "         ", 
           RowBox[{"Max", "[", 
            RowBox[{"0.", ",", " ", 
             RowBox[{"Round", "[", 
              RowBox[{"mu", " ", "+", " ", 
               RowBox[{
                RowBox[{"Sqrt", "[", "mu", "]"}], " ", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{
                  RowBox[{"-", "2."}], " ", 
                  RowBox[{"Log", "[", 
                   RowBox[{"RandomReal", "[", "]"}], "]"}]}], "]"}], " ", 
                RowBox[{"Cos", "[", 
                 RowBox[{"2.", " ", "Pi", " ", 
                  RowBox[{"RandomReal", "[", "]"}]}], "]"}]}]}], "]"}]}], 
            "]"}], ",", "\n", "         ", 
           RowBox[{
            RowBox[{"limit", " ", "=", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"-", "mu"}], "]"}]}], ";", " ", 
            RowBox[{"k", " ", "=", " ", "0"}], ";", " ", 
            RowBox[{"p", " ", "=", " ", "1."}], ";", "\n", "         ", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"p", " ", ">", " ", "limit"}], ",", " ", 
              RowBox[{
               RowBox[{"k", "++"}], ";", " ", 
               RowBox[{"p", " ", "*=", " ", 
                RowBox[{"RandomReal", "[", "]"}]}]}]}], "]"}], ";", "\n", 
            "         ", 
            RowBox[{"N", "[", 
             RowBox[{"k", " ", "-", " ", "1"}], "]"}]}]}], "]"}]}], "]"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"RuntimeAttributes", " ", "->", " ", 
      RowBox[{"{", "Listable", "}"}]}], ",", " ", 
     RowBox[{"Parallelization", " ", "->", " ", "True"}]}], "]"}]}], ";"}], "\n", 
