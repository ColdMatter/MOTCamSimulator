            RowBox[{"Spacings", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", "0"}], "}"}]}]}], "]"}], ",", " ", 
          "card"}], "}"}], ",", " ", 
        RowBox[{"Spacings", " ", "->", " ", "1.5"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
