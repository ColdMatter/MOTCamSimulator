     ")"}], " ", "@@@", " ", "benchmarkCurveKeys"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"saturationMarker", "[", 
    RowBox[{"name_String", ",", " ", "binFactor_"}], "]"}], " ", ":=", "\n", 
   "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
