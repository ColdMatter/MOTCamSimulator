Cell[CellGroupData[{

Cell["4. Single-Shot Visibility: Peak-Pixel SNR vs Binning", "Section",ExpressionUUID->"efaba3ef-37f5-4bc3-a58c-f5ae9b5fd71c"],

Cell["\<\
This section is about seeing the cloud in a raw single shot, not about \
measuring the molecule number. The relevant quantity is the signal to noise \
of the brightest superpixel: the cloud is marginal at peakPixelSNR ~ 3 and \
unmistakable at ~5, whereas the aperture-integrated SNR of Section 2 can be \
in the hundreds while no individual pixel stands out.\
\>", "Text",ExpressionUUID->"95d4713a-b4ab-460e-99bb-232cb2899710"],

Cell["\<\
This is the one place where software binning genuinely helps. Binning b x b \
multiplies the signal per superpixel by b^2 and its noise by b, so \
peakPixelSNR grows in proportion to b for every camera, hardware-binned or \
not. It buys visibility, not precision: the integrated SNR is unchanged \
(software) or improved separately (hardware), as Section 3 shows.\
\>", "Text",ExpressionUUID->"428dc211-bf22-450c-a7d1-8b1e16a35d00"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"visibilityThreshold", " ", "=", " ", "5"}], ";"}], "      ", 
  RowBox[{"(*", " ", 
   RowBox[{"peak", "-", 
    RowBox[{
    "pixel", " ", "SNR", " ", "at", " ", "which", " ", "the", " ", "cloud", " ",
      "is", " ", "unmistakable", " ", "in", " ", "a", " ", "raw", " ", 
     "frame"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"visibilityThresholdMarginal", " ", "=", " ", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"visibilityPanel", "[", "name_String", "]"}], " ", ":=", "\n", 
   "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cam", " ", "=", " ", 
        RowBox[{"cameraDatabase", "[", "name", "]"}]}], ",", " ", "bins"}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"cam", " ", "=", " ", 
       RowBox[{"cameraDatabase", "[", "name", "]"}]}], ";", " ", 
      RowBox[{"bins", " ", "=", " ", 
       RowBox[{"cam", "[", "\"\<SupportedBins\>\"", "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"LogLogPlot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"peakPixelSNR", "[", 
            RowBox[{"cam", ",", " ", "#", ",", " ", "nMol"}], "]"}], " ", 
           "&"}], " ", "/@", " ", "bins"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"nMol", ",", " ", "moleculeMin", ",", " ", "moleculeMax"}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"PlotStyle", " ", "->", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"cameraColors", "[", "name", "]"}], ",", " ", 
              RowBox[{"AbsoluteThickness", "[", "1.6", "]"}], ",", " ", 
              RowBox[{"Opacity", "[", 
               RowBox[{"0.35", " ", "+", " ", 
                RowBox[{"0.65", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{"bins", ",", " ", "#"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ",
                     "1"}], ")"}], "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Length", "[", "bins", "]"}], " ", "-", " ", 
                    "1"}], ")"}]}]}]}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
            " ", "bins"}], ")"}]}], ",", "\n", "      ", 
        RowBox[{"PlotRange", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"moleculeMin", ",", " ", "moleculeMax"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0.02", ",", " ", "2000"}], "}"}]}], "}"}]}], ",", " ", 
        RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
        RowBox[{"Axes", " ", "->", " ", "False"}], ",", "\n", "      ", 
        RowBox[{"FrameLabel", " ", "->", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Molecules in the MOT\>\"", ",", 
           " ", "\"\<Peak-pixel SNR\>\""}], "}"}]}], ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"cameraShortName", "[", "name", "]"}], " ", "<>", 
            " ", "\"\< (\>\"", " ", "<>", " ", 
            RowBox[{"cam", "[", "\"\<BinningType\>\"", "]"}], " ", "<>", 
            " ", "\"\< binning)\>\""}], ",", " ", "11"}], "]"}]}], ",", "\n", 
        "      ", 
        RowBox[{"GridLines", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"workingPointMolecules", ",", " ", 
              RowBox[{"Directive", "[", 
               RowBox[{"Blue", ",", " ", "Dashed", ",", " ", 
                RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}]}], "}"}], "}"}],
            ",", "\n", "                    ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"visibilityThreshold", ",", " ", 
