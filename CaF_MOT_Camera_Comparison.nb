          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{"binLabel", " ", "/@", " ", "bins"}], ",", " ", 
             RowBox[{"LegendLabel", " ", "->", " ", "\"\<bin\>\""}]}], "]"}], 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{"0.83", ",", " ", "0.26"}], "}"}]}], "]"}]}], ",", "\n", 
        "      ", 
        RowBox[{"ImageSize", " ", "->", " ", "330"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"visibilityGrid", " ", "=", " ", 
  RowBox[{"Multicolumn", "[", 
   RowBox[{
